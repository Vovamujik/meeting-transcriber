# Hugging Face token (type: Read). Only needed for speaker labels (diarization).
# 1. Accept the model terms: https://huggingface.co/pyannote/speaker-diarization-community-1
# 2. Create a token:         https://huggingface.co/settings/tokens
# Put this file at ~/.config/meeting-transcriber/.env (or .env in the repo root when running from a clone).
# Alternatives: `uvx --from huggingface_hub hf auth login`, or `export HF_TOKEN=...`.
HF_TOKEN=
